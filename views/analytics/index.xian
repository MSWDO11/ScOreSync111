<!DOCTYPE html>
<html lang="en">
<head>
  {{> head }}
</head>
<body class="bg-slate-50 text-slate-800 flex h-screen overflow-hidden font-sans antialiased">

  <!-- Sidebar -->
  {{> sidebar }}

  <!-- Main content wrapper -->
  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

    <!-- Top Navbar -->
    {{> navbar title="AI Score Analytics & Anomaly Detection" }}

    <!-- Flash Notifications -->
    {{> flash }}

    <!-- Page Body -->
    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

      <!-- Header Section -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-6 rounded-2xl text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="space-y-1 z-10">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
              <svg class="w-3 h-3 mr-1 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
              Gemini AI Powered
            </span>
            <span class="text-xs text-slate-400">Official LGU Festival Tabulation Auditor</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">Score Analytics & Anomaly Detector</h1>
          <p class="text-slate-300 text-xs sm:text-sm max-w-2xl">
            Automatically scans judge score submissions in real-time to spot extreme score divergence, judge bias, score manipulation, and uniform scoring patterns across festival events.
          </p>
        </div>

        <!-- Run Audit & Export Controls -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 z-10">
          <form id="auditForm" method="POST" action="/analytics/run" class="flex flex-col sm:flex-row gap-2">
            <select name="eventId" class="bg-slate-800 text-white text-xs font-semibold rounded-xl px-3 py-2.5 border border-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-500">
              <option value="all">All Festival Events</option>
              {{#each events}}
              <option value="{{id}}" {{#if (eq id ../selectedEventId)}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <button type="submit" id="runAuditBtn" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-lg transition active:scale-95 flex items-center justify-center gap-1.5 whitespace-nowrap">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <span>Run AI Audit</span>
            </button>
          </form>

          <div class="flex items-center gap-2">
            <a href="/analytics/export?type=flags" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs px-3 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 whitespace-nowrap" title="Download flagged anomaly logs in CSV format">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Export Logs CSV</span>
            </a>
            <a href="/analytics/export?type=report" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs px-3 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 whitespace-nowrap" title="Download AI audit report summaries in CSV format">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              <span>Report CSV</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Loading Overlay Indicator (Hidden by default) -->
      <div id="auditLoading" class="hidden bg-white border border-purple-100 rounded-2xl p-8 shadow-lg text-center space-y-4 animate-fade-in">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-purple-50 text-purple-600 mb-2">
          <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-800">Gemini AI Audit in Progress...</h3>
        <p class="text-xs text-slate-500 max-w-md mx-auto">Analyzing raw judge scores, standard deviation matrices, and peer consensus across criteria. This will take a few seconds.</p>
      </div>

      <!-- Results Overview Cards (If a report exists) -->
      {{#if latestReport}}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Health Score -->
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
          <div>
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Tabulation Health</div>
            <div class="text-2xl font-black text-slate-900 mt-1">{{latestReport.healthScore}}<span class="text-sm font-normal text-slate-400">/100</span></div>
            <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Judging Consistency</div>
          </div>
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center font-bold text-sm
            {{#if (gte latestReport.healthScore 80)}}bg-emerald-50 text-emerald-600 border border-emerald-200
            {{else}}{{#if (gte latestReport.healthScore 60)}}bg-amber-50 text-amber-600 border border-amber-200
            {{else}}bg-red-50 text-red-600 border border-red-200{{/if}}{{/if}}">
            {{latestReport.healthScore}}%
          </div>
        </div>

        <!-- Risk Level -->
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
          <div>
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Audit Risk Level</div>
            <div class="text-xl font-black mt-1 uppercase tracking-tight
              {{#if (eq latestReport.riskLevel 'LOW')}}text-emerald-600
              {{else}}{{#if (eq latestReport.riskLevel 'MODERATE')}}text-amber-600
              {{else}}{{#if (eq latestReport.riskLevel 'HIGH')}}text-orange-600
              {{else}}text-red-600{{/if}}{{/if}}{{/if}}">
              {{latestReport.riskLevel}}
            </div>
            <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Anomaly Severity Index</div>
          </div>
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center
            {{#if (eq latestReport.riskLevel 'LOW')}}bg-emerald-50 text-emerald-600
            {{else}}{{#if (eq latestReport.riskLevel 'MODERATE')}}bg-amber-50 text-amber-600
            {{else}}bg-red-50 text-red-600{{/if}}{{/if}}">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
        </div>

        <!-- Consensus Rate -->
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
          <div>
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Judge Consensus</div>
            <div class="text-2xl font-black text-slate-900 mt-1">{{latestReport.judgingConsensusRate}}%</div>
            <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Peer Agreement Level</div>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
        </div>

        <!-- Total Audited -->
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
          <div>
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Audited</div>
            <div class="text-2xl font-black text-slate-900 mt-1">{{latestReport.totalScoresAudited}}</div>
            <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Raw Judge Submissions</div>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
        </div>

      </div>

      <!-- AI Summary Banner -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-2">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-purple-600 animate-ping"></div>
          <h3 class="text-xs font-bold text-purple-900 uppercase tracking-wider">AI Executive Audit Findings</h3>
        </div>
        <p class="text-sm font-medium text-slate-700 leading-relaxed">{{latestReport.summaryText}}</p>
      </div>
      {{/if}}

      <!-- Flagged Anomalies List -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
          <div>
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              Flagged Scoring Anomalies
            </h2>
            <p class="text-xs text-slate-500">Real-time alerts requiring administrative review before official results certification.</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-red-50 text-red-700 text-xs font-bold border border-red-100">
              {{flags.length}} Active Flags
            </span>
          </div>
        </div>

        {{#if flags.length}}
        <div class="divide-y divide-slate-100">
          {{#each flags}}
          <div class="p-5 hover:bg-slate-50/80 transition space-y-3">
            
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <!-- Severity badge -->
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider
                  {{#if (eq severity 'CRITICAL')}}bg-red-100 text-red-800 border border-red-200
                  {{else}}{{#if (eq severity 'HIGH')}}bg-orange-100 text-orange-800 border border-orange-200
                  {{else}}{{#if (eq severity 'MEDIUM')}}bg-amber-100 text-amber-800 border border-amber-200
                  {{else}}bg-blue-100 text-blue-800 border border-blue-200{{/if}}{{/if}}{{/if}}">
                  {{severity}} SEVERITY
                </span>

                <!-- Anomaly Type -->
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                  {{type}}
                </span>

                <span class="text-xs font-bold text-slate-800">Event: {{eventName}}</span>
              </div>

              <!-- Action buttons for admin -->
              <div class="flex items-center gap-2">
                <form method="POST" action="/analytics/flags/{{id}}/status" class="inline">
                  <input type="hidden" name="status" value="reviewed">
                  <button type="submit" class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                    Mark Reviewed
                  </button>
                </form>
                <form method="POST" action="/analytics/flags/{{id}}/status" class="inline">
                  <input type="hidden" name="status" value="dismissed">
                  <button type="submit" class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 transition">
                    Dismiss
                  </button>
                </form>
                <form method="POST" action="/analytics/flags/{{id}}/status" class="inline">
                  <input type="hidden" name="status" value="action_taken">
                  <button type="submit" class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-700 transition">
                    Action Taken
                  </button>
                </form>
              </div>
            </div>

            <!-- Entities & Score Metrics -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-slate-50 p-3 rounded-xl text-xs">
              <div>
                <span class="text-slate-400 font-medium">Judge:</span>
                <span class="font-bold text-slate-800 ml-1">{{judgeName}}</span>
              </div>
              <div>
                <span class="text-slate-400 font-medium">Contestant:</span>
                <span class="font-bold text-slate-800 ml-1">{{contestantName}}</span>
              </div>
              <div>
                <span class="text-slate-400 font-medium">Criteria:</span>
                <span class="font-bold text-slate-800 ml-1">{{criteriaName}}</span>
              </div>
            </div>

            <!-- Score Variance Breakdown -->
            <div class="flex items-center gap-4 text-xs">
              <div class="flex items-center gap-1.5">
                <span class="text-slate-500 font-medium">Recorded Score:</span>
                <span class="font-black text-slate-900 bg-white px-2 py-0.5 rounded border border-slate-200">{{recordedScore}}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-slate-500 font-medium">Peer Judge Avg:</span>
                <span class="font-bold text-slate-700 bg-white px-2 py-0.5 rounded border border-slate-200">{{peerAverage}}</span>
              </div>
              {{#if delta}}
              <div class="flex items-center gap-1.5">
                <span class="text-slate-500 font-medium">Divergence:</span>
                <span class="font-black {{#if (gt delta 0)}}text-red-600{{else}}text-amber-600{{/if}}">
                  {{#if (gt delta 0)}}+{{/if}}{{delta}} pts
                </span>
              </div>
              {{/if}}
            </div>

            <!-- Description & Recommendation -->
            <div class="space-y-1 text-xs">
              <p class="text-slate-700 font-medium"><strong>Observation:</strong> {{description}}</p>
              <p class="text-purple-900 font-semibold bg-purple-50/60 p-2 rounded-lg border border-purple-100">
                <strong>Recommended Admin Action:</strong> {{recommendedAction}}
              </p>
            </div>

          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="p-12 text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="text-sm font-bold text-slate-800">No Active Score Anomalies Flagged</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">Either no scores have been submitted yet, or the last AI audit verified full judging consensus with zero flags.</p>
        </div>
        {{/if}}
      </div>

      <!-- AI Recommendations & Strategic Insights -->
      {{#if latestReport.insights}}
      <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-6 rounded-2xl shadow-lg space-y-4">
        <div class="flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3 class="text-sm font-bold uppercase tracking-wider text-purple-300">Tabulation Protocol Insights</h3>
        </div>
        <ul class="space-y-2 text-xs text-slate-200">
          {{#each latestReport.insights}}
          <li class="flex items-start gap-2 bg-white/5 p-3 rounded-xl border border-white/10">
            <span class="text-purple-400 font-bold">•</span>
            <span>{{this}}</span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

    </main>
  </div>

  <script>
    document.getElementById('auditForm').addEventListener('submit', function() {
      document.getElementById('auditLoading').classList.remove('hidden');
      document.getElementById('runAuditBtn').disabled = true;
      document.getElementById('runAuditBtn').innerHTML = 'Auditing...';
    });
  </script>
</body>
</html>
