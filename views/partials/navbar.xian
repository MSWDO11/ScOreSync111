<div id="sidebar-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>

<nav class="h-14 bg-white border-b border-slate-100 flex items-center px-3 sm:px-5 gap-2.5 sticky top-0 z-30"
  style="box-shadow:0 1px 0 #f1f5f9,0 4px 16px rgba(0,0,0,0.04)">

  <!-- Mobile Hamburger Toggle -->
  <button type="button" onclick="toggleMobileSidebar()" class="md:hidden p-2 text-slate-700 hover:text-slate-900 focus:outline-none rounded-xl hover:bg-slate-100 transition flex-shrink-0" aria-label="Toggle Navigation Menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Brand -->
  <a href="/dashboard" class="flex items-center gap-2 flex-shrink-0">
    <div class="w-7 h-7 grad-gold rounded-lg flex items-center justify-center shadow">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
    </div>
    <span class="font-black text-slate-800 text-sm tracking-tight hidden sm:block">ScoreSync</span>
  </a>

  <!-- Breadcrumb -->
  <div class="hidden lg:flex items-center gap-1.5 text-sm text-slate-400 flex-shrink-0 ml-1">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="text-slate-500">{{ title }}</span>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 sm:gap-2.5 ml-auto flex-shrink-0">

    <!-- Stage Timer Quick Launcher -->
    <button type="button" onclick="if(window.ScoreSyncTimer){ScoreSyncTimer.toggleFullscreen();}else{const t=document.getElementById('scoresync-timer-component');if(t){t.scrollIntoView({behavior:'smooth'});}else{window.location.href='/dashboard';}}" title="Stage & Round Timer (F11 / Stage Monitor)"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold transition border border-indigo-200/80 shadow-2xs">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span class="hidden sm:inline">Stage Timer</span>
    </button>

    <!-- Inventory navbar link (admin only) -->
    {{#if isAdmin}}
    <a href="/inventory" title="Inventory"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-bold transition border border-amber-200/80">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
        <line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
      <span class="hidden sm:inline">Inventory</span>
    </a>
    {{/if}}

    <!-- Settings navbar link/button -->
    <a href="/settings" title="Settings"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 hover:bg-slate-200/90 text-slate-700 text-xs font-bold transition border border-slate-200/70">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      <span class="hidden sm:inline">Settings</span>
    </a>

    <!-- Role badge -->
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold border shadow-2xs
      {{#if isAdmin}}bg-blue-50 text-blue-700 border-blue-200/80{{else}}{{#if isJudge}}bg-purple-50 text-purple-700 border-purple-200/80{{else}}bg-emerald-50 text-emerald-700 border-emerald-200/80{{/if}}{{/if}}">
      {{#if isAdmin}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6.5 1-4.8 4.5 1.2 6.5L12 16l-5.9 3 1.2-6.5L2.5 8 9 7z"/></svg>
      {{else}}{{#if isJudge}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      {{else}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/></svg>
      {{/if}}{{/if}}
      <span class="capitalize">{{userRole}}</span>
    </span>

    <!-- Profile Pill -->
    <a href="/settings" class="flex items-center gap-2 pl-1 pr-3 py-1 rounded-full bg-slate-100/70 hover:bg-slate-200/70 border border-slate-200/80 transition group">
      <div class="w-7 h-7 rounded-full grad-brand flex items-center justify-center text-white text-xs font-black shadow-xs flex-shrink-0">
        {{ userInitial }}
      </div>
      <span class="text-xs font-bold text-slate-800 max-w-[160px] sm:max-w-[200px] truncate group-hover:text-blue-700 transition">{{ userName }}</span>
    </a>

  </div>
</nav>
