{{> head }}
<body class="bg-slate-50 min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}
  <div class="alert-success animate-fadeup flex items-center gap-3 p-4 rounded-xl shadow-sm border border-emerald-200 bg-emerald-50 text-emerald-800 text-sm font-semibold">
    <div class="w-7 h-7 rounded-lg bg-emerald-500 text-white flex items-center justify-center flex-shrink-0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <span class="flex-1">{{success_msg}}</span>
  </div>
  {{/if}}

  {{#if error_msg}}
  <div class="alert-error animate-fadeup flex items-center gap-3 p-4 rounded-xl shadow-sm border border-rose-200 bg-rose-50 text-rose-800 text-sm font-semibold">
    <div class="w-7 h-7 rounded-lg bg-rose-500 text-white flex items-center justify-center flex-shrink-0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <span class="flex-1">{{error_msg}}</span>
  </div>
  {{/if}}

  <!-- Header Banner -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-7 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-5 relative overflow-hidden animate-fadeup">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold bg-purple-50 text-purple-700 border border-purple-100">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Official Judge Panel
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight pt-1">
        Welcome, <span class="bg-gradient-to-r from-purple-700 to-indigo-600 bg-clip-text text-transparent">{{userName}}</span> 👋
      </h1>
      <p class="text-slate-500 text-sm font-medium">Select an assigned event below to submit official scores per contestant.</p>
    </div>
  </div>

  <!-- Instruction Banner -->
  <div class="p-5 rounded-2xl border border-purple-200 bg-gradient-to-r from-purple-50 via-indigo-50 to-purple-50 shadow-sm flex items-start gap-4 animate-fadeup-1">
    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-600 to-indigo-700 text-white flex items-center justify-center flex-shrink-0 shadow-md shadow-purple-500/20">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <div>
      <h3 class="font-extrabold text-purple-950 text-sm">Scoring Guidelines</h3>
      <p class="text-purple-800/90 text-xs font-medium mt-0.5 leading-relaxed">
        Click <span class="px-2 py-0.5 rounded bg-purple-600 text-white font-bold text-[11px]">Score Now</span> on active events. Ensure scores adhere strictly to official percentage weights (0 to 100%).
      </p>
    </div>
  </div>

  <!-- Events List Card -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden animate-fadeup-2">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h2 class="text-base font-extrabold text-slate-900 tracking-tight">Events Available for Scoring</h2>
      </div>
    </div>

    {{#if recentEvents.length}}
    <div class="divide-y divide-slate-100">
      {{#each recentEvents}}
      <div class="p-5 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/80 transition group">
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white shadow-xs font-bold"
            style="background: linear-gradient(135deg, #4c1d95, #7c3aed);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-base group-hover:text-purple-700 transition">{{name}}</h3>
            <p class="text-slate-500 text-xs mt-0.5 flex items-center gap-1">
              {{#if venue}}<span>{{venue}}</span> &bull; {{/if}}
              <span>{{date}}</span>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3 self-end sm:self-center">
          <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}badge-yellow{{/if}}{{/if}} capitalize">
            {{status}}
          </span>
          {{#if (eq status 'ongoing')}}
          <a href="/events/{{id}}/scoring" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-md shadow-purple-500/20 transition">
            Score Now
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          {{else}}
          <a href="/events/{{id}}/results" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 transition">
            View Results
          </a>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="py-16 text-center text-slate-400 px-4">
      <div class="w-16 h-16 bg-purple-50 text-purple-400 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-purple-100 shadow-sm">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <h3 class="font-bold text-slate-700 text-base mb-1">No Scoring Events Available</h3>
      <p class="text-slate-400 text-xs max-w-sm mx-auto">Please contact the administrator or head tabulator to assign scoring events to your judge account.</p>
    </div>
    {{/if}}
  </div>

</main>
</div>
{{> footer }}
</body>
</html>

