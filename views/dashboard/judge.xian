{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- Header -->
  <div class="rounded-2xl p-5 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5 relative overflow-hidden animate-fadeup"
    style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(109,40,217,0.07)"></div>
    <div class="relative z-10 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold"
        style="background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.25)">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Official Judge Panel
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight" style="color:#f1f5f9">
        Welcome, <span style="background:linear-gradient(90deg,#a78bfa,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span> 👋
      </h1>
      <p class="text-sm font-medium" style="color:#475569">Select an assigned event below to submit official scores per contestant.</p>
    </div>
  </div>

  <!-- Instruction Banner -->
  <div class="p-4 sm:p-5 rounded-2xl flex items-start gap-4 animate-fadeup-1"
    style="background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.2)">
    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white shadow-md"
      style="background:linear-gradient(135deg,#6d28d9,#4f46e5)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <div>
      <h3 class="font-extrabold text-sm" style="color:#c4b5fd">Scoring Guidelines</h3>
      <p class="text-xs font-medium mt-1 leading-relaxed" style="color:#7c3aed">
        Click <span class="px-2 py-0.5 rounded font-bold text-[11px] text-white" style="background:#7c3aed">Score Now</span> on active events. Ensure scores adhere strictly to official percentage weights (0 to 100%).
      </p>
    </div>
  </div>

  <!-- Events List -->
  <div class="rounded-2xl overflow-hidden animate-fadeup-2"
    style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="px-5 sm:px-6 py-4 flex items-center justify-between"
      style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center"
          style="background:rgba(139,92,246,0.2);border:1px solid rgba(139,92,246,0.3)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h2 class="text-sm sm:text-base font-extrabold tracking-tight" style="color:#e2e8f0">Events Available for Scoring</h2>
      </div>
    </div>

    {{#if recentEvents.length}}
    <div>
      {{#each recentEvents}}
      <div class="p-4 sm:p-5 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition"
        style="border-top:1px solid rgba(255,255,255,0.05)"
        onmouseover="this.style.background='rgba(139,92,246,0.05)'" onmouseout="this.style.background=''">
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
            style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-sm sm:text-base" style="color:#e2e8f0">{{name}}</h3>
            <p class="text-xs mt-0.5" style="color:#475569">
              {{#if venue}}{{venue}} &bull; {{/if}}{{date}}
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3 self-end sm:self-center flex-shrink-0">
          <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}badge-yellow{{/if}}{{/if}} capitalize">{{status}}</span>
          {{#if (eq status 'ongoing')}}
          <a href="/events/{{id}}/scoring" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs text-white transition"
            style="background:linear-gradient(135deg,#6d28d9,#7c3aed);box-shadow:0 4px 12px rgba(109,40,217,0.3)">
            Score Now
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          {{else}}
          <a href="/events/{{id}}/results" class="btn-sm btn-sm-gray text-xs">View Results</a>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="py-16 text-center px-4">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
        style="background:rgba(139,92,246,0.10);border:1px solid rgba(139,92,246,0.15)">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <h3 class="font-bold text-sm mb-1" style="color:#e2e8f0">No Scoring Events Available</h3>
      <p class="text-xs max-w-xs mx-auto" style="color:#374151">Contact the administrator to assign scoring events to your account.</p>
    </div>
    {{/if}}
  </div>

</main>
</div>
{{> footer }}
</body>
</html>
