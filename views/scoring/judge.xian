{{> head }}
<body class="bg-slate-50 min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">
  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <div class="flex items-start justify-between animate-fadeup">
    <div class="page-header mb-0">
      <div class="breadcrumb"><a href="/events/{{event.id}}">Back to {{event.name}}</a></div>
      <h1>Score Entry</h1>
      <p>Enter scores for each contestant. Scores are calculated in real-time as you type.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="#scoresync-timer-component" onclick="document.getElementById('scoresync-timer-component')?.scrollIntoView({behavior:'smooth'})" class="btn-sm bg-indigo-600 hover:bg-indigo-700 text-white font-bold flex-shrink-0 mt-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Stage Timer
      </a>
      <button type="button" id="autoFillBtn" class="btn-sm btn-sm-purple flex-shrink-0 mt-1" style="background:#8b5cf6;color:white;border:none;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Auto-Fill Demo Scores
      </button>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green flex-shrink-0 mt-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        View Results
      </a>
    </div>
  </div>

  <!-- Stage & Round Countdown Timer for Judges / Tabulators -->
  <div class="animate-fadeup-1">
    {{> countdown_timer }}
  </div>

  {{#if contestants.length}}
  <form id="scoringForm" method="POST" action="/events/{{event.id}}/scoring" class="space-y-5 animate-fadeup-1">
    {{#each contestants}}
    <div class="section-card overflow-hidden contestant-card" data-contestant-id="{{id}}">
      <div class="px-6 py-4 flex items-center justify-between relative overflow-hidden" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
        <div class="absolute right-0 top-0 w-32 h-32 rounded-full translate-x-10 -translate-y-10" style="background:rgba(255,255,255,0.05)"></div>
        <div class="flex items-center gap-4 relative">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-extrabold text-sm flex-shrink-0 relative" style="background:rgba(255,255,255,0.20)">{{number}}</div>
          <div class="relative">
            <div class="text-white font-bold text-base">{{name}}</div>
            <div class="text-blue-200 text-xs mt-0.5">{{#if barangay}}Brgy. {{barangay}}{{/if}}{{#if age}} &bull; {{age}} yrs{{/if}}</div>
          </div>
        </div>
        <div class="relative flex items-center gap-3">
          <div class="text-right">
            <div class="text-[10px] text-blue-200 uppercase font-bold tracking-wider">Automated Total</div>
            <div class="text-white font-extrabold text-lg contestant-total-score">0.00%</div>
          </div>
          <div class="px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-900/50 text-blue-100 border border-blue-400/30 contestant-progress">
            0/{{scores.length}} completed
          </div>
        </div>
      </div>
      <div class="p-5 grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {{#each scores}}
        <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 hover:border-blue-200 hover:bg-blue-50 transition score-box">
          <div class="flex items-start justify-between mb-3">
            <span class="text-sm font-semibold text-slate-700 leading-snug">{{criteriaName}}</span>
            <span class="badge badge-purple flex-shrink-0 ml-2">{{weight}}%</span>
          </div>
          <input type="number" 
            name="scores[{{../id}}][{{criteriaId}}]" 
            value="{{value}}" 
            min="0" 
            max="{{maxScore}}" 
            step="0.01" 
            placeholder="0"
            data-weight="{{weight}}"
            data-max="{{maxScore}}"
            class="score-input form-input-bare text-center text-lg font-bold text-blue-700 bg-white"
          />
          <div class="flex items-center justify-between text-xs text-slate-400 mt-2">
            <span>max <strong class="text-slate-600">{{maxScore}}</strong> pts</span>
            <span class="weighted-preview font-semibold text-blue-600">0.00%</span>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}
    <div class="card-flat px-6 py-4 flex items-center justify-between no-print animate-fadeup-2">
      <p class="text-slate-500 text-sm flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Scores auto-calculate live and auto-save as draft locally. Click submit to save officially.</span>
      </p>
      <div class="flex items-center gap-3">
        <button type="button" id="clearDraftBtn" class="px-4 py-2 text-xs font-semibold text-slate-500 hover:text-slate-700">Clear Draft</button>
        <button type="submit" class="btn-primary text-sm px-8 py-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Submit All Scores
        </button>
      </div>
    </div>
  </form>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("scoringForm");
      if (!form) return;

      const eventId = "{{event.id}}";
      const storageKey = `scoresync_draft_${eventId}`;

      function calculateTotals() {
        const contestantCards = document.querySelectorAll(".contestant-card");
        const draftData = {};

        contestantCards.forEach(card => {
          const contestantId = card.dataset.contestantId;
          const inputs = card.querySelectorAll(".score-input");
          let totalWeighted = 0;
          let completedCount = 0;

          draftData[contestantId] = {};

          inputs.forEach(input => {
            const valStr = input.value.trim();
            const val = parseFloat(valStr);
            const max = parseFloat(input.dataset.max) || 100;
            const weight = parseFloat(input.dataset.weight) || 0;
            const weightedSpan = input.closest(".score-box").querySelector(".weighted-preview");

            if (!isNaN(val) && valStr !== "") {
              completedCount++;
              // Cap at max if user enters more
              const clampedVal = Math.min(Math.max(0, val), max);
              if (clampedVal !== val) {
                input.value = clampedVal;
              }
              const weightedPct = (clampedVal / max) * weight;
              totalWeighted += weightedPct;
              weightedSpan.textContent = weightedPct.toFixed(2) + "%";
              draftData[contestantId][input.name] = clampedVal;
            } else {
              weightedSpan.textContent = "0.00%";
            }
          });

          const totalDisplay = card.querySelector(".contestant-total-score");
          const progressDisplay = card.querySelector(".contestant-progress");

          if (totalDisplay) totalDisplay.textContent = totalWeighted.toFixed(2) + "%";
          if (progressDisplay) {
            progressDisplay.textContent = `${completedCount}/${inputs.length} completed`;
            if (completedCount === inputs.length && inputs.length > 0) {
              progressDisplay.className = "px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/30 text-emerald-100 border border-emerald-400/40 contestant-progress";
            } else {
              progressDisplay.className = "px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-900/50 text-blue-100 border border-blue-400/30 contestant-progress";
            }
          }
        });

        // Save draft to localStorage automatically
        try {
          localStorage.setItem(storageKey, JSON.stringify(draftData));
        } catch(e){}
      }

      // Auto fill demo scores feature
      const autoFillBtn = document.getElementById("autoFillBtn");
      if (autoFillBtn) {
        autoFillBtn.addEventListener("click", () => {
          const inputs = document.querySelectorAll(".score-input");
          inputs.forEach(input => {
            const max = parseFloat(input.dataset.max) || 100;
            // Generate realistic score between 75% and 98% of max
            const minScore = max * 0.75;
            const randScore = Math.floor((minScore + Math.random() * (max - minScore)) * 10) / 10;
            input.value = randScore;
          });
          calculateTotals();
        });
      }

      // Clear draft feature
      const clearDraftBtn = document.getElementById("clearDraftBtn");
      if (clearDraftBtn) {
        clearDraftBtn.addEventListener("click", () => {
          if (confirm("Are you sure you want to clear draft scores on this form?")) {
            localStorage.removeItem(storageKey);
            const inputs = document.querySelectorAll(".score-input");
            inputs.forEach(input => { if(!input.hasAttribute("data-initial")) input.value = ""; });
            calculateTotals();
          }
        });
      }

      // Listen for input changes
      form.addEventListener("input", calculateTotals);

      // Initial calculation on load
      calculateTotals();
    });
  </script>
  {{else}}
  <div class="card-flat py-20 text-center text-slate-400 animate-fadeup-1">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-4"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="23" y2="8"/></svg>
    <p class="font-semibold text-base mb-1">No contestants found.</p>
    <a href="/events/{{event.id}}" class="text-blue-600 hover:underline text-sm">Go back to event</a>
  </div>
  {{/if}}
</main>
</div>
{{> footer }}
</body>
</html>
