{{> head }}
<body class="bg-slate-50 min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  <div class="flex items-start justify-between animate-fadeup no-print">
    <div class="page-header mb-0">
      <div class="breadcrumb"><a href="/events/{{event.id}}">Back to {{event.name}}</a></div>
      <h1>Official Results</h1>
      <p>Tabulated from <span class="font-semibold text-blue-600">{{judgeCount}}</span> judge(s)</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="inline-flex items-center gap-2 bg-white px-3 py-1.5 rounded-lg border border-slate-200 text-xs text-slate-600">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
        <span>Auto-refresh:</span>
        <select id="autoRefreshInterval" class="bg-transparent font-bold text-blue-600 outline-none cursor-pointer">
          <option value="0">Off</option>
          <option value="5" selected>Every 5s</option>
          <option value="10">Every 10s</option>
          <option value="30">Every 30s</option>
        </select>
        <span id="refreshCountdown" class="text-[11px] font-mono text-slate-400 min-w-[20px] text-right">5s</span>
      </div>
      <button onclick="window.print()" class="btn-sm btn-sm-gray flex-shrink-0 no-print">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Print
      </button>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const select = document.getElementById("autoRefreshInterval");
      const countdown = document.getElementById("refreshCountdown");
      if (!select || !countdown) return;

      let timer = null;
      let secondsLeft = parseInt(select.value, 10);

      function startTimer() {
        clearInterval(timer);
        const intervalSec = parseInt(select.value, 10);
        if (intervalSec <= 0) {
          countdown.textContent = "Paused";
          return;
        }
        secondsLeft = intervalSec;
        countdown.textContent = secondsLeft + "s";

        timer = setInterval(() => {
          secondsLeft--;
          if (secondsLeft <= 0) {
            clearInterval(timer);
            window.location.reload();
          } else {
            countdown.textContent = secondsLeft + "s";
          }
        }, 1000);
      }

      select.addEventListener("change", startTimer);
      startTimer();
    });
  </script>

  {{#if ranked.length}}
  <div class="card-flat p-6 animate-fadeup-1">
    <h2 class="text-center text-xs font-bold text-slate-400 uppercase tracking-widest mb-6">Top Finishers</h2>
    <div class="flex items-end justify-center gap-4 max-w-lg mx-auto">
      {{#each ranked}}{{#if (eq rank 2)}}
      <div class="flex-1 text-center">
        <div class="text-4xl mb-2">🥈</div>
        <div class="rounded-2xl p-4 border-2 border-slate-200 bg-slate-50">
          <div class="text-xs text-slate-400 uppercase font-bold tracking-wide mb-1">2nd</div>
          <div class="font-extrabold text-slate-800 text-sm leading-tight">{{name}}</div>
          {{#if barangay}}<div class="text-slate-400 text-xs mt-1">Brgy. {{barangay}}</div>{{/if}}
          <div class="text-2xl font-black text-slate-700 mt-2">{{finalScoreDisplay}}<span class="text-sm font-normal">%</span></div>
        </div>
      </div>
      {{/if}}{{/each}}
      {{#each ranked}}{{#if (eq rank 1)}}
      <div class="flex-1 text-center -mt-4">
        <div class="text-5xl mb-2">🥇</div>
        <div class="rounded-2xl p-5 border-2 border-yellow-300 shadow-lg" style="background:linear-gradient(180deg,#fffbeb,#fef3c7)">
          <div class="text-xs text-yellow-600 uppercase font-bold tracking-wide mb-1">Champion</div>
          <div class="font-extrabold text-slate-900 text-base leading-tight">{{name}}</div>
          {{#if barangay}}<div class="text-slate-500 text-xs mt-1">Brgy. {{barangay}}</div>{{/if}}
          <div class="text-3xl font-black text-yellow-600 mt-2">{{finalScoreDisplay}}<span class="text-sm font-normal">%</span></div>
        </div>
      </div>
      {{/if}}{{/each}}
      {{#each ranked}}{{#if (eq rank 3)}}
      <div class="flex-1 text-center">
        <div class="text-4xl mb-2">🥉</div>
        <div class="rounded-2xl p-4 border-2 border-orange-200 bg-orange-50">
          <div class="text-xs text-orange-500 uppercase font-bold tracking-wide mb-1">3rd</div>
          <div class="font-extrabold text-slate-800 text-sm leading-tight">{{name}}</div>
          {{#if barangay}}<div class="text-slate-400 text-xs mt-1">Brgy. {{barangay}}</div>{{/if}}
          <div class="text-2xl font-black text-orange-600 mt-2">{{finalScoreDisplay}}<span class="text-sm font-normal">%</span></div>
        </div>
      </div>
      {{/if}}{{/each}}
    </div>
  </div>

  <div class="section-card animate-fadeup-2 overflow-x-auto">
    <div class="section-header">
      <h2>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        Full Tabulation Sheet
      </h2>
      <span class="badge badge-blue">{{event.name}}</span>
    </div>
    <table class="data-table min-w-max">
      <thead>
        <tr>
          <th class="w-12 text-center">Rank</th>
          <th class="w-10">No.</th>
          <th>Contestant</th>
          <th>Barangay</th>
          {{#each criteria}}<th class="text-center">{{name}}<br/><span class="text-[10px] font-normal normal-case text-slate-400">{{weight}}%</span></th>{{/each}}
          <th class="text-center text-blue-700">Final Score</th>
        </tr>
      </thead>
      <tbody>
        {{#each ranked}}
        <tr class="{{#if (eq rank 1)}}bg-yellow-50{{/if}}">
          <td class="text-center">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-sm font-black
              {{#if (eq rank 1)}}bg-yellow-400 text-white
              {{else}}{{#if (eq rank 2)}}bg-slate-300 text-white
              {{else}}{{#if (eq rank 3)}}bg-orange-400 text-white
              {{else}}bg-slate-100 text-slate-500{{/if}}{{/if}}{{/if}}">{{rank}}</span>
          </td>
          <td class="text-slate-400 font-mono text-sm">{{number}}</td>
          <td class="font-semibold text-slate-800">{{name}}</td>
          <td class="text-slate-500 text-sm">{{barangay}}</td>
          {{#each breakdown}}<td class="text-center"><div class="font-semibold text-slate-700">{{avg}}</div><div class="text-[11px] text-slate-400">({{weighted}}%)</div></td>{{/each}}
          <td class="text-center"><span class="font-extrabold text-blue-700 text-base">{{finalScoreDisplay}}%</span></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="card-flat py-20 text-center text-slate-400 animate-fadeup-1">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-4"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
    <p class="font-semibold text-base mb-1">No scores submitted yet.</p>
    <p class="text-sm">Judges need to submit scores before results appear.</p>
  </div>
  {{/if}}
</main>
</div>
{{> footer }}
</body>
</html>
