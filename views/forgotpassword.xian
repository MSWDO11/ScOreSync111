{{> head }}
<body class="min-h-screen flex" style="background:#0a0f1e">

  <!-- Left Panel -->
  <div class="hidden lg:flex lg:w-[46%] flex-col justify-between p-10 relative overflow-hidden"
    style="background:linear-gradient(160deg,#060d1f 0%,#0f2156 45%,#1a4db5 78%,#2563eb 100%)">
    <div class="absolute top-0 left-0 w-96 h-96 rounded-full -translate-x-1/2 -translate-y-1/2" style="background:rgba(255,255,255,0.04)"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full translate-x-1/3 translate-y-1/3" style="background:rgba(255,255,255,0.04)"></div>

    <div class="relative z-10">
      <div class="flex items-center gap-4 mb-12">
        <div class="w-14 h-14 rounded-full overflow-hidden flex-shrink-0 shadow-2xl" style="border:3px solid rgba(255,255,255,0.25)">
          <img src="/mansalay-logo.png" alt="Mansalay Seal" class="w-full h-full object-cover"/>
        </div>
        <div>
          <div class="text-white font-black text-xl tracking-tight leading-none">ScoreSync</div>
          <div class="text-blue-300 text-xs font-medium mt-0.5" style="opacity:0.75">Mansalay, Oriental Mindoro</div>
        </div>
      </div>

      <h2 class="text-white font-black leading-tight tracking-tight mb-4" style="font-size:2rem">
        Forgot your<br/>password?
      </h2>
      <p class="text-sm leading-relaxed max-w-xs" style="color:rgba(147,197,253,0.85)">
        No worries — enter your registered email and we'll send you a secure reset link right away.
      </p>
    </div>

    <p class="relative z-10 text-xs" style="color:rgba(147,197,253,0.4)">&copy; 2026 ScoreSync — Mansalay, Oriental Mindoro</p>
  </div>

  <!-- Right Panel -->
  <div class="flex-1 flex items-center justify-center px-5 py-10" style="background:#0a0f1e">
    <div class="w-full max-w-[420px] animate-fadeup">

      <!-- Mobile logo -->
      <div class="flex items-center gap-3 justify-center mb-7 lg:hidden">
        <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0 shadow-xl" style="border:2px solid rgba(255,255,255,0.2)">
          <img src="/mansalay-logo.png" alt="Mansalay Seal" class="w-full h-full object-cover"/>
        </div>
        <div>
          <div class="font-black text-xl text-white tracking-tight">ScoreSync</div>
          <div class="text-xs" style="color:#475569">Mansalay, Or. Mindoro</div>
        </div>
      </div>

      <!-- Card -->
      <div class="rounded-2xl overflow-hidden shadow-2xl" style="background:#111827;border:1px solid rgba(255,255,255,0.10)">
        <div class="h-1.5" style="background:linear-gradient(90deg,#1d4ed8,#6366f1,#8b5cf6)"></div>

        <div class="p-7 sm:p-8">
          <!-- Icon + Heading -->
          <div class="flex items-center gap-4 mb-7">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg grad-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
            </div>
            <div>
              <h1 class="text-xl font-black tracking-tight" style="color:#f1f5f9">Reset your password</h1>
              <p class="text-xs mt-0.5" style="color:#475569">We'll send a reset link to your registered email.</p>
            </div>
          </div>

          {{#if error_msg}}<div class="alert-error mb-5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg><span>{{error_msg}}</span></div>{{/if}}
          {{#if success_msg}}<div class="alert-success mb-5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg><span>{{success_msg}}</span></div>{{/if}}

          <form method="POST" action="/forgot-password" class="space-y-5">
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Email Address</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </span>
                <input type="email" name="email" placeholder="you@example.com" required class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:#e2e8f0;outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>
            <button type="submit" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm text-white transition hover:opacity-90 active:scale-95"
              style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);box-shadow:0 4px 14px rgba(37,99,235,0.4)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send Reset Link
            </button>
          </form>
        </div>
      </div>

      <p class="text-center mt-5">
        <a href="/login" class="inline-flex items-center gap-1.5 text-sm font-semibold hover:underline" style="color:#60a5fa">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Sign In
        </a>
      </p>
    </div>
  </div>
</body>
</html>
