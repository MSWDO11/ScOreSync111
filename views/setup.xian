{{> head }}
<body class="min-h-screen flex" style="background:#f0f4ff">
  <div class="hidden lg:flex lg:w-[44%] auth-panel-bg flex-col justify-between p-10 relative">
    <div class="relative z-10">
      <div class="flex items-center gap-3 mb-14">
        <div class="w-10 h-10 grad-gold rounded-2xl flex items-center justify-center shadow-xl">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <span class="text-white font-black text-xl tracking-tight">ScoreSync</span>
      </div>
      <h2 class="text-white text-3xl font-black leading-tight tracking-tight mb-4">First-time<br/>Setup</h2>
      <p class="text-blue-200 text-sm leading-relaxed max-w-xs">Create the administrator account that will manage all events, users, and scoring criteria.</p>
    </div>
    <div class="relative z-10 space-y-3">
      <div class="flex items-center gap-3 rounded-2xl px-4 py-3" style="background:rgba(255,255,255,0.09);border:1px solid rgba(255,255,255,0.12)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span class="text-blue-100 text-sm">This runs <strong>once</strong> — after an admin exists, this page is locked.</span>
      </div>
      <p class="text-blue-300 text-xs" style="opacity:0.6">&copy; 2026 ScoreSync &mdash; Mansalay, Oriental Mindoro</p>
    </div>
  </div>

  <div class="flex-1 flex items-center justify-center px-6 py-10">
    <div class="w-full max-w-[420px] animate-fadeup">
      {{#if hasUsers}}
      <div class="text-center">
        <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg" style="background:linear-gradient(135deg,#064e3b,#059669)">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h1 class="text-2xl font-black text-slate-900 mb-2">Setup Already Complete</h1>
        <p class="text-slate-500 text-sm mb-6">An admin account already exists. Please sign in normally.</p>
        <a href="/login" class="btn-primary text-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Go to Login
        </a>
      </div>
      {{else}}
      <div class="flex items-center gap-2.5 justify-center mb-8 lg:hidden">
        <div class="w-10 h-10 grad-gold rounded-2xl flex items-center justify-center shadow-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <span class="font-black text-xl text-slate-800">ScoreSync</span>
      </div>
      <div class="bg-white rounded-2xl p-8" style="box-shadow:0 4px 32px rgba(0,0,0,0.10)">
        <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-bold mb-5" style="background:#fef3c7;color:#92400e;border:1px solid #fde68a">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
          First-time Setup
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mb-1">Create Admin Account</h1>
        <p class="text-slate-500 text-sm mb-7">This account will have full access to ScoreSync.</p>
        {{#if error_msg}}<div class="alert-error mb-5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span>{{error_msg}}</span></div>{{/if}}
        <form method="POST" action="/setup" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Full Name</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
              <input type="text" name="name" placeholder="e.g. Juan dela Cruz" required autocomplete="name"
                style="width:100%;padding:11px 14px 11px 40px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:0.875rem;color:#0f172a;outline:none;background:#fff;"
                onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.12)'"
                onblur="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'"/>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Email Address</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
              <input type="email" name="email" placeholder="admin@yourdomain.com" required autocomplete="email"
                style="width:100%;padding:11px 14px 11px 40px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:0.875rem;color:#0f172a;outline:none;background:#fff;"
                onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.12)'"
                onblur="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'"/>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Password</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
              <input type="password" name="password" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password"
                style="width:100%;padding:11px 14px 11px 40px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:0.875rem;color:#0f172a;outline:none;background:#fff;"
                onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.12)'"
                onblur="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'"/>
            </div>
          </div>
          <div class="flex items-center gap-3 rounded-xl px-4 py-3" style="background:#eff6ff;border:1px solid #bfdbfe">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div><div class="text-sm font-semibold text-blue-800">Role: Administrator</div><div class="text-xs text-blue-500">Automatically assigned for first account</div></div>
          </div>
          <button type="submit" class="btn-primary w-full py-3 text-sm justify-center mt-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
            Create Admin &amp; Enter ScoreSync
          </button>
        </form>
      </div>
      <p class="text-center text-sm text-slate-400 mt-5">Already have an account? <a href="/login" class="text-blue-600 font-medium hover:underline">Sign in</a></p>
      {{/if}}
    </div>
  </div>
</body>
</html>
