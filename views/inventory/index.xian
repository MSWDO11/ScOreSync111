{{> head }}
<body class="bg-slate-50 min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <!-- Page Header -->
  <div class="card-flat overflow-hidden animate-fadeup">
    <div class="px-7 py-6 relative overflow-hidden" style="background:linear-gradient(135deg,#92400e,#f59e0b)">
      <div class="absolute top-0 right-0 w-48 h-48 rounded-full translate-x-16 -translate-y-16" style="background:rgba(255,255,255,0.06)"></div>
      <div class="relative flex items-start justify-between gap-4">
        <div>
          <div class="breadcrumb mb-2" style="color:rgba(254,243,199,0.8)">
            <a href="/dashboard" style="color:rgba(254,243,199,0.9)">Dashboard</a>
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            <span>Inventory</span>
          </div>
          <h1 class="text-white text-2xl font-extrabold tracking-tight">Event Inventory</h1>
          <p class="text-amber-100 text-sm mt-1 opacity-80">Track equipment, props, and supplies per event.</p>
        </div>
        <div class="flex-shrink-0 w-12 h-12 rounded-2xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-5 animate-fadeup-1">

    <!-- LEFT: Filter + Table -->
    <div class="lg:col-span-2 space-y-4">

      <!-- Event Filter -->
      <div class="card-flat px-5 py-4">
        <form method="GET" action="/inventory" class="flex flex-wrap items-end gap-3">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">Filter by Event</label>
            <select name="eventId" onchange="this.form.submit()" class="form-input-bare bg-white w-full">
              <option value="">— All Events —</option>
              {{#each events}}
              <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </div>
          {{#if filterEventId}}
          <a href="/inventory" class="btn-sm btn-sm-gray flex-shrink-0">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Clear Filter
          </a>
          {{/if}}
        </form>
      </div>

      <!-- Items Table -->
      <div class="section-card">
        <div class="section-header">
          <h2>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            {{#if selectedEvent}}{{selectedEvent.name}} — Items{{else}}All Inventory Items{{/if}}
            <span class="ml-2 bg-amber-100 text-amber-700 text-xs font-bold px-2 py-0.5 rounded-full">{{items.length}}</span>
          </h2>
        </div>

        {{#if items.length}}
        <div class="overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>Item</th>
                <th>Category</th>
                {{#unless filterEventId}}<th>Event</th>{{/unless}}
                <th>Qty</th>
                <th>Condition</th>
                {{#if isAdmin}}<th class="text-right">Actions</th>{{/if}}
              </tr>
            </thead>
            <tbody>
              {{#each items}}
              <tr>
                <td>
                  <div class="font-semibold text-slate-800">{{name}}</div>
                  {{#if notes}}<div class="text-slate-400 text-xs mt-0.5 truncate max-w-xs">{{notes}}</div>{{/if}}
                </td>
                <td>
                  <span class="badge badge-gray capitalize">{{category}}</span>
                </td>
                {{#unless ../filterEventId}}
                <td class="text-slate-500 text-xs">{{eventName}}</td>
                {{/unless}}
                <td>
                  <span class="font-bold text-slate-800">{{quantity}}</span>
                  <span class="text-slate-400 text-xs ml-0.5">{{unit}}</span>
                </td>
                <td>
                  <span class="badge {{#if (eq condition 'good')}}badge-green{{else}}{{#if (eq condition 'damaged')}}badge-red{{else}}badge-yellow{{/if}}{{/if}} capitalize">
                    {{condition}}
                  </span>
                </td>
                {{#if ../isAdmin}}
                <td class="text-right">
                  <!-- Inline edit form (modal-free, inline row) -->
                  <button type="button"
                    onclick="openEditModal('{{id}}','{{name}}','{{category}}','{{quantity}}','{{unit}}','{{condition}}','{{notes}}','{{eventId}}')"
                    class="btn-sm btn-sm-gray text-xs px-2.5 py-1.5 mr-1">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <form method="POST" action="/inventory/{{id}}/delete" class="inline" onsubmit="return confirm('Remove this item?')">
                    <input type="hidden" name="eventId" value="{{eventId}}"/>
                    <button class="btn-sm btn-sm-red text-xs px-2.5 py-1.5">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                    </button>
                  </form>
                </td>
                {{/if}}
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="py-14 text-center text-slate-400 text-sm">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-3">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          </svg>
          {{#if filterEventId}}No inventory items for this event yet.{{else}}No inventory items found. Add one using the form.{{/if}}
        </div>
        {{/if}}
      </div>
    </div>

    <!-- RIGHT: Add Item Form -->
    {{#if isAdmin}}
    <div class="space-y-4">
      <div class="card-flat">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center shadow-sm" style="background:linear-gradient(135deg,#92400e,#f59e0b)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <h2 class="font-bold text-slate-800">Add Item</h2>
        </div>
        <form method="POST" action="/inventory" class="px-6 py-5 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Event <span class="text-red-500">*</span></label>
            <select name="eventId" required class="form-input-bare bg-white">
              <option value="">Select an event…</option>
              {{#each events}}
              <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Item Name <span class="text-red-500">*</span></label>
            <input type="text" name="name" placeholder="e.g. Crown, Sash, Sound System" required class="form-input-bare"/>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Category</label>
              <select name="category" class="form-input-bare bg-white">
                <option value="general">General</option>
                <option value="props">Props</option>
                <option value="equipment">Equipment</option>
                <option value="costume">Costume</option>
                <option value="awards">Awards</option>
                <option value="supplies">Supplies</option>
                <option value="decor">Decor</option>
                <option value="av">Audio/Visual</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Condition</label>
              <select name="condition" class="form-input-bare bg-white">
                <option value="good">Good</option>
                <option value="fair">Fair</option>
                <option value="damaged">Damaged</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Quantity</label>
              <input type="number" name="quantity" value="1" min="1" class="form-input-bare"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Unit</label>
              <input type="text" name="unit" placeholder="pcs" class="form-input-bare"/>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Notes</label>
            <textarea name="notes" rows="2" placeholder="Optional notes…" class="form-input-bare resize-none"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full py-2.5 text-sm justify-center">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add to Inventory
          </button>
        </form>
      </div>
    </div>
    {{/if}}

  </div><!-- /grid -->

</main>
</div>

<!-- Edit Modal -->
<div id="edit-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden" style="background:rgba(0,0,0,0.45)">
  <div class="card-flat w-full max-w-md mx-4 shadow-2xl">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
      <h3 class="font-bold text-slate-800">Edit Inventory Item</h3>
      <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-slate-700 transition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="edit-form" method="POST" action="" class="px-6 py-5 space-y-4">
      <input type="hidden" name="eventId" id="edit-eventId"/>
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Item Name <span class="text-red-500">*</span></label>
        <input type="text" name="name" id="edit-name" required class="form-input-bare"/>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Category</label>
          <select name="category" id="edit-category" class="form-input-bare bg-white">
            <option value="general">General</option>
            <option value="props">Props</option>
            <option value="equipment">Equipment</option>
            <option value="costume">Costume</option>
            <option value="awards">Awards</option>
            <option value="supplies">Supplies</option>
            <option value="decor">Decor</option>
            <option value="av">Audio/Visual</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Condition</label>
          <select name="condition" id="edit-condition" class="form-input-bare bg-white">
            <option value="good">Good</option>
            <option value="fair">Fair</option>
            <option value="damaged">Damaged</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Quantity</label>
          <input type="number" name="quantity" id="edit-quantity" min="1" class="form-input-bare"/>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Unit</label>
          <input type="text" name="unit" id="edit-unit" class="form-input-bare"/>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Notes</label>
        <textarea name="notes" id="edit-notes" rows="2" class="form-input-bare resize-none"></textarea>
      </div>
      <div class="flex gap-2 pt-1">
        <button type="submit" class="btn-primary flex-1 py-2.5 text-sm justify-center">Save Changes</button>
        <button type="button" onclick="closeEditModal()" class="btn-secondary px-5 py-2.5 text-sm">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditModal(id, name, category, qty, unit, condition, notes, eventId) {
  document.getElementById('edit-form').action = '/inventory/' + id + '/update';
  document.getElementById('edit-name').value      = name;
  document.getElementById('edit-quantity').value  = qty;
  document.getElementById('edit-unit').value      = unit;
  document.getElementById('edit-notes').value     = notes;
  document.getElementById('edit-eventId').value   = eventId;
  const catSel = document.getElementById('edit-category');
  for (let o of catSel.options) o.selected = (o.value === category);
  const conSel = document.getElementById('edit-condition');
  for (let o of conSel.options) o.selected = (o.value === condition);
  document.getElementById('edit-modal').classList.remove('hidden');
}
function closeEditModal() {
  document.getElementById('edit-modal').classList.add('hidden');
}
document.getElementById('edit-modal').addEventListener('click', function(e) {
  if (e.target === this) closeEditModal();
});
</script>

{{> footer }}
</body>
</html>
