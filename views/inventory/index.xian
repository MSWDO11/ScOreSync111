{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Page Header ── -->
  <div class="rounded-2xl overflow-hidden animate-fadeup" style="background:linear-gradient(135deg,#064e3b 0%,#059669 55%,#0f766e 100%);border:1px solid rgba(16,185,129,0.25)">
    <div class="px-7 py-6 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 rounded-full translate-x-24 -translate-y-24" style="background:rgba(255,255,255,0.04)"></div>
      <div class="relative flex items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2 text-xs" style="color:rgba(110,231,183,0.7)">
            <a href="/dashboard" style="color:rgba(110,231,183,0.9)" class="hover:underline">Dashboard</a>
            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            <span>Ticket Sales &amp; Income</span>
          </div>
          <h1 class="text-white text-2xl font-extrabold tracking-tight">Ticket Sales &amp; Income</h1>
          <p class="text-emerald-100 text-sm mt-1 opacity-80">Track tickets sold and income collected per event.</p>
        </div>
        <!-- KPIs + Add button -->
        <div class="flex items-center gap-3 flex-shrink-0">
          <div class="hidden sm:flex items-center gap-3">
            <div class="px-4 py-3 rounded-xl text-center" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.15)">
              <div class="text-white font-black text-xl leading-none">{{items.length}}</div>
              <div class="text-emerald-100 text-[10px] font-bold uppercase tracking-wide mt-0.5">Records</div>
            </div>
            <div class="px-4 py-3 rounded-xl text-center" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.15)">
              <div class="text-white font-black text-xl leading-none">{{totalItems}}</div>
              <div class="text-emerald-100 text-[10px] font-bold uppercase tracking-wide mt-0.5">Tickets Sold</div>
            </div>
            <div class="px-4 py-3 rounded-xl text-center" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.15)">
              <div class="text-white font-black text-xl leading-none">₱{{totalValue}}</div>
              <div class="text-emerald-100 text-[10px] font-bold uppercase tracking-wide mt-0.5">Total Income</div>
            </div>
          </div>
          {{#if isAdmin}}
          <button onclick="openAddModal()"
            class="flex items-center gap-2 px-5 py-3 rounded-xl font-extrabold text-sm flex-shrink-0 transition"
            style="background:rgba(255,255,255,0.18);color:#fff;border:1px solid rgba(255,255,255,0.28)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Record
          </button>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Filter bar ── -->
  <div class="rounded-2xl px-5 py-4 animate-fadeup-1" style="background:#111827;border:1px solid rgba(255,255,255,0.07)">
    <form method="GET" action="/inventory" class="flex flex-wrap items-end gap-3">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Filter by Event</label>
        <select name="eventId" onchange="this.form.submit()" class="form-input-bare w-full">
          <option value="">— All Events —</option>
          {{#each events}}
          <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>
      {{#if filterEventId}}
      <span class="px-3 py-2 rounded-xl text-xs font-bold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">
        {{items.length}} records &middot; ₱{{totalValue}} income
      </span>
      <a href="/inventory" class="btn-sm btn-sm-gray flex-shrink-0">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        Clear
      </a>
      <a href="/inventory/export?eventId={{filterEventId}}" class="btn-sm btn-sm-green flex-shrink-0">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
      </a>
      {{/if}}
    </form>
  </div>

  <!-- ── Records Table ── -->
  <div class="rounded-2xl overflow-hidden animate-fadeup-1" style="background:#111827;border:1px solid rgba(255,255,255,0.07)">

    <div class="px-6 py-4 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.06)">
      <h2 class="text-sm font-extrabold flex items-center gap-2" style="color:#e2e8f0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        {{#if selectedEvent}}{{selectedEvent.name}} — Ticket Sales{{else}}All Ticket Sales Records{{/if}}
        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">{{items.length}}</span>
      </h2>
      {{#if isAdmin}}
      <button onclick="openAddModal()" class="btn-sm btn-sm-green text-xs">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Record
      </button>
      {{/if}}
    </div>

    {{#if items.length}}
    <div class="overflow-x-auto">
      <table class="data-table w-full">
        <thead>
          <tr>
            <th class="w-8 text-center">#</th>
            <th>Ticket / Income Type</th>
            {{#unless filterEventId}}<th>Event</th>{{/unless}}
            <th class="text-center">Qty Sold</th>
            <th class="text-center">Unit Price</th>
            <th class="text-center">Total Income</th>
            <th>Notes</th>
            {{#if isAdmin}}<th class="text-right w-20">Actions</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td class="text-center text-xs font-mono" style="color:#374151">{{@index}}</td>
            <!-- Ticket type -->
            <td>
              <div class="flex items-center gap-3">
                {{#if photo}}
                <img src="{{photo}}" alt="" class="w-9 h-9 rounded-lg object-cover flex-shrink-0" style="border:1px solid rgba(255,255,255,0.08)"/>
                {{else}}
                <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(16,185,129,0.10);border:1px solid rgba(16,185,129,0.18)">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
                </div>
                {{/if}}
                <div class="font-semibold text-sm" style="color:#e2e8f0">{{ticketType}}</div>
              </div>
            </td>
            {{#unless ../filterEventId}}
            <td class="text-xs" style="color:#475569">{{eventName}}</td>
            {{/unless}}
            <!-- Qty -->
            <td class="text-center font-black text-sm" style="color:#e2e8f0">{{quantity}}</td>
            <!-- Unit price -->
            <td class="text-center text-sm" style="color:#94a3b8">₱{{unitPrice}}</td>
            <!-- Total -->
            <td class="text-center">
              <span class="font-black text-sm" style="color:#6ee7b7">₱{{totalValue}}</span>
            </td>
            <!-- Notes -->
            <td class="text-xs truncate max-w-[180px]" style="color:#374151">{{#if notes}}{{notes}}{{else}}—{{/if}}</td>
            <!-- Actions -->
            {{#if ../isAdmin}}
            <td class="text-right">
              <div class="flex items-center justify-end gap-1">
                <button type="button"
                  onclick="openEditModal('{{id}}','{{ticketType}}','{{quantity}}','{{unitPrice}}','{{notes}}','{{eventId}}','{{photo}}')"
                  class="btn-sm btn-sm-gray text-xs px-2.5 py-1.5">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <form method="POST" action="/inventory/{{id}}/delete" class="inline" onsubmit="return confirm('Remove this record?')">
                  <input type="hidden" name="eventId" value="{{eventId}}"/>
                  <button class="btn-sm btn-sm-red text-xs px-2.5 py-1.5">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                  </button>
                </form>
              </div>
            </td>
            {{/if}}
          </tr>
          {{/each}}
        </tbody>
        <tfoot>
          <tr style="border-top:2px solid rgba(16,185,129,0.2)">
            <td colspan="{{#if filterEventId}}4{{else}}5{{/if}}" class="px-6 py-3 text-xs font-extrabold uppercase tracking-widest text-right" style="color:#4b5563">
              Total Tickets Sold: <span style="color:#e2e8f0">{{totalItems}}</span>
            </td>
            <td class="px-6 py-3 text-center font-black text-base" style="color:#6ee7b7">₱{{totalValue}}</td>
            <td></td>
            {{#if isAdmin}}<td></td>{{/if}}
          </tr>
        </tfoot>
      </table>
    </div>

    {{else}}
    <div class="py-20 text-center">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15)">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5">
          <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/>
        </svg>
      </div>
      <p class="font-bold text-sm mb-1" style="color:#e2e8f0">{{#if filterEventId}}No ticket records for this event yet{{else}}No ticket sales records yet{{/if}}</p>
      <p class="text-xs mb-6" style="color:#374151">{{#if filterEventId}}Add ticket types and sales to track income for this event.{{else}}Select an event to filter, or add your first record.{{/if}}</p>
      {{#if isAdmin}}
      <button onclick="openAddModal()" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-extrabold transition"
        style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add First Record
      </button>
      {{/if}}
    </div>
    {{/if}}
  </div>

</main>
</div>

<!-- ══════════════════════════════════════════
     ADD RECORD MODAL
══════════════════════════════════════════ -->
<div id="add-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden" style="background:rgba(0,0,0,0.75)">
  <div class="w-full max-w-md mx-4 rounded-2xl overflow-hidden shadow-2xl" style="background:#111827;border:1px solid rgba(16,185,129,0.2)">
    <div class="px-6 py-5 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(16,185,129,0.07)">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.35)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div>
          <h3 class="font-extrabold text-sm" style="color:#e2e8f0">Add Ticket / Income Record</h3>
          <p class="text-[11px]" style="color:#374151">Record ticket sales or other income</p>
        </div>
      </div>
      <button onclick="closeAddModal()" style="color:#475569" class="hover:text-white transition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <form method="POST" action="/inventory" class="px-6 py-6 space-y-4">
      <!-- Event -->
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Event <span style="color:#ef4444">*</span></label>
        <select name="eventId" required class="form-input-bare w-full">
          <option value="">Select an event…</option>
          {{#each events}}
          <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>

      <!-- Ticket / Income type -->
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Ticket / Income Type <span style="color:#ef4444">*</span></label>
        <input type="text" name="ticketType" placeholder="e.g. General Admission, VIP Ticket, Sponsor Fee…" required class="form-input-bare"/>
      </div>

      <!-- Quick type presets -->
      <div class="flex flex-wrap gap-1.5">
        <label class="block text-[10px] font-extrabold uppercase tracking-widest w-full" style="color:#4b5563">Quick Presets</label>
        <button type="button" onclick="setTicketType('General Admission')"  class="preset-pill">General Admission</button>
        <button type="button" onclick="setTicketType('VIP Ticket')"         class="preset-pill">VIP Ticket</button>
        <button type="button" onclick="setTicketType('Student Ticket')"     class="preset-pill">Student Ticket</button>
        <button type="button" onclick="setTicketType('Sponsor Fee')"        class="preset-pill">Sponsor Fee</button>
        <button type="button" onclick="setTicketType('Registration Fee')"   class="preset-pill">Registration Fee</button>
        <button type="button" onclick="setTicketType('Donation')"           class="preset-pill">Donation</button>
        <button type="button" onclick="setTicketType('Merchandise')"        class="preset-pill">Merchandise</button>
        <button type="button" onclick="setTicketType('LGU Grant')"          class="preset-pill">LGU Grant</button>
      </div>

      <!-- Qty + Price -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Quantity / Count</label>
          <input type="number" name="quantity" value="1" min="0" class="form-input-bare"/>
        </div>
        <div>
          <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Unit Price (₱)</label>
          <input type="number" name="unitPrice" placeholder="0.00" min="0" step="0.01" id="add-unit-price" oninput="calcPreview()" class="form-input-bare"/>
        </div>
      </div>

      <!-- Total preview -->
      <div class="flex items-center justify-between px-4 py-3 rounded-xl" style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15)">
        <span class="text-xs font-extrabold uppercase tracking-widest" style="color:#4b5563">Est. Total Income</span>
        <span id="add-total-preview" class="font-black text-base" style="color:#6ee7b7">₱0.00</span>
      </div>

      <!-- Photo (optional receipt/QR) -->
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Attachment <span style="color:#1f2937;font-weight:400;font-size:9px;text-transform:none">optional — receipt / QR</span></label>
        <div id="inv-photo-dropzone" onclick="document.getElementById('inv-photo-file').click()"
          class="flex items-center gap-3 px-4 py-3 rounded-xl cursor-pointer transition"
          style="border:2px dashed rgba(16,185,129,0.2);background:rgba(16,185,129,0.04)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <div>
            <div class="text-xs font-semibold" style="color:#10b981">Upload attachment</div>
            <div class="text-[10px]" style="color:#374151">PNG/JPG · max 2MB</div>
          </div>
        </div>
        <input type="file" id="inv-photo-file" accept="image/*" class="hidden" onchange="handleInvPhoto(this)"/>
        <input type="hidden" name="photo" id="inv-photo-b64"/>
        <div id="inv-photo-preview" class="hidden mt-2 flex items-center gap-3">
          <img id="inv-photo-img" src="" alt="" class="w-14 h-14 rounded-xl object-cover" style="border:1px solid rgba(255,255,255,0.08)"/>
          <button type="button" onclick="clearInvPhoto()" class="btn-sm btn-sm-red text-xs">Remove</button>
        </div>
      </div>

      <!-- Notes -->
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Notes</label>
        <textarea name="notes" rows="2" placeholder="e.g. Sold at gate, pre-sold online…" class="form-input-bare resize-none"></textarea>
      </div>

      <div class="flex gap-3 pt-1">
        <button type="submit" class="btn-primary flex-1 py-3 text-sm justify-center"
          style="background:linear-gradient(135deg,#059669,#10b981);box-shadow:0 4px 14px rgba(16,185,129,0.3)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Save Record
        </button>
        <button type="button" onclick="closeAddModal()" class="btn-secondary px-6 py-3 text-sm">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- ══════════════════════════════════════════
     EDIT RECORD MODAL
══════════════════════════════════════════ -->
<div id="edit-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden" style="background:rgba(0,0,0,0.75)">
  <div class="w-full max-w-md mx-4 rounded-2xl overflow-hidden shadow-2xl" style="background:#111827;border:1px solid rgba(255,255,255,0.10)">
    <div class="px-6 py-5 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.07)">
      <h3 class="font-extrabold text-sm" style="color:#e2e8f0">Edit Record</h3>
      <button type="button" onclick="closeEditModal()" style="color:#475569" class="hover:text-white transition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="edit-form" method="POST" action="" class="px-6 py-6 space-y-4">
      <input type="hidden" name="eventId" id="edit-eventId"/>
      <input type="hidden" name="photo"   id="edit-photo-b64"/>
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Ticket / Income Type <span style="color:#ef4444">*</span></label>
        <input type="text" name="ticketType" id="edit-ticketType" required class="form-input-bare"/>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Quantity</label>
          <input type="number" name="quantity" id="edit-quantity" min="0" class="form-input-bare"/>
        </div>
        <div>
          <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Unit Price (₱)</label>
          <input type="number" name="unitPrice" id="edit-unitPrice" min="0" step="0.01" class="form-input-bare"/>
        </div>
      </div>
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Notes</label>
        <textarea name="notes" id="edit-notes" rows="2" class="form-input-bare resize-none"></textarea>
      </div>
      <!-- Photo -->
      <div>
        <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Attachment</label>
        <div id="edit-photo-existing" class="hidden mb-2">
          <img id="edit-photo-img" src="" alt="" class="w-14 h-14 rounded-xl object-cover" style="border:1px solid rgba(255,255,255,0.08)"/>
        </div>
        <div class="flex gap-2">
          <button type="button" onclick="document.getElementById('edit-photo-file').click()" class="btn-sm btn-sm-gray text-xs flex-1 justify-center">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Replace
          </button>
          <button type="button" onclick="clearEditPhoto()" class="btn-sm btn-sm-red text-xs">Remove</button>
        </div>
        <input type="file" id="edit-photo-file" accept="image/*" class="hidden" onchange="handleEditPhoto(this)"/>
      </div>
      <div class="flex gap-2 pt-1">
        <button type="submit" class="btn-primary flex-1 py-2.5 text-sm justify-center">Save Changes</button>
        <button type="button" onclick="closeEditModal()" class="btn-secondary px-5 py-2.5 text-sm">Cancel</button>
      </div>
    </form>
  </div>
</div>

<style>
.preset-pill {
  padding: 4px 10px; border-radius: 999px; font-size: 0.7rem; font-weight: 700;
  cursor: pointer; transition: all 0.15s;
  background: rgba(255,255,255,0.05); color: #64748b;
  border: 1px solid rgba(255,255,255,0.08);
}
.preset-pill:hover { background: rgba(16,185,129,0.15); color: #6ee7b7; border-color: rgba(16,185,129,0.3); }
</style>

<script>
/* ── Add modal ── */
function openAddModal()  { document.getElementById('add-modal').classList.remove('hidden'); }
function closeAddModal() { document.getElementById('add-modal').classList.add('hidden'); }
document.getElementById('add-modal').addEventListener('click', function(e) { if(e.target===this) closeAddModal(); });

/* ── Edit modal ── */
function openEditModal(id, ticketType, qty, unitPrice, notes, eventId, photo) {
  document.getElementById('edit-form').action          = '/inventory/' + id + '/update';
  document.getElementById('edit-ticketType').value     = ticketType;
  document.getElementById('edit-quantity').value       = qty;
  document.getElementById('edit-unitPrice').value      = unitPrice;
  document.getElementById('edit-notes').value          = notes;
  document.getElementById('edit-eventId').value        = eventId;
  document.getElementById('edit-photo-b64').value      = photo || '';
  const imgEl   = document.getElementById('edit-photo-img');
  const imgWrap = document.getElementById('edit-photo-existing');
  if (photo) { imgEl.src = photo; imgWrap.classList.remove('hidden'); }
  else        { imgWrap.classList.add('hidden'); }
  document.getElementById('edit-modal').classList.remove('hidden');
}
function closeEditModal() { document.getElementById('edit-modal').classList.add('hidden'); }
document.getElementById('edit-modal').addEventListener('click', function(e) { if(e.target===this) closeEditModal(); });

/* ── Quick preset type setter ── */
function setTicketType(val) {
  document.querySelector('[name=ticketType]').value = val;
}

/* ── Live total preview ── */
function calcPreview() {
  const qty   = parseFloat(document.querySelector('[name=quantity]')?.value || 0);
  const price = parseFloat(document.getElementById('add-unit-price')?.value || 0);
  const total = (qty * price).toFixed(2);
  const el = document.getElementById('add-total-preview');
  if (el) el.textContent = '₱' + parseFloat(total).toLocaleString('en-PH', {minimumFractionDigits:2});
}
document.querySelector('[name=quantity]')?.addEventListener('input', calcPreview);

/* ── Photo handlers ── */
function handleInvPhoto(input) {
  const file = input.files[0]; if (!file) return;
  if (file.size > 2*1024*1024) { alert('Max 2MB'); input.value=''; return; }
  const r = new FileReader();
  r.onload = e => {
    document.getElementById('inv-photo-b64').value = e.target.result;
    document.getElementById('inv-photo-img').src   = e.target.result;
    document.getElementById('inv-photo-preview').classList.remove('hidden');
    document.getElementById('inv-photo-dropzone').classList.add('hidden');
  };
  r.readAsDataURL(file);
}
function clearInvPhoto() {
  document.getElementById('inv-photo-b64').value = '';
  document.getElementById('inv-photo-preview').classList.add('hidden');
  document.getElementById('inv-photo-dropzone').classList.remove('hidden');
  document.getElementById('inv-photo-file').value = '';
}
function handleEditPhoto(input) {
  const file = input.files[0]; if (!file) return;
  const r = new FileReader();
  r.onload = e => {
    document.getElementById('edit-photo-b64').value = e.target.result;
    const img = document.getElementById('edit-photo-img');
    img.src = e.target.result;
    document.getElementById('edit-photo-existing').classList.remove('hidden');
  };
  r.readAsDataURL(file);
}
function clearEditPhoto() {
  document.getElementById('edit-photo-b64').value = '';
  document.getElementById('edit-photo-existing').classList.add('hidden');
}
</script>

{{> footer }}
</body>
</html>
