{{> head }}
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col font-sans">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}
  <div class="alert-success animate-fadeup flex items-center gap-3 p-4 rounded-xl shadow-sm border border-emerald-200 bg-emerald-50 text-emerald-800 text-sm font-semibold">
    <div class="w-7 h-7 rounded-lg bg-emerald-500 text-white flex items-center justify-center flex-shrink-0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <span class="flex-1">{{success_msg}}</span>
  </div>
  {{/if}}

  {{#if error_msg}}
  <div class="alert-error animate-fadeup flex items-center gap-3 p-4 rounded-xl shadow-sm border border-rose-200 bg-rose-50 text-rose-800 text-sm font-semibold">
    <div class="w-7 h-7 rounded-lg bg-rose-500 text-white flex items-center justify-center flex-shrink-0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <span class="flex-1">{{error_msg}}</span>
  </div>
  {{/if}}

  <!-- Banner -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-7 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-5 relative overflow-hidden animate-fadeup">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold bg-blue-50 text-blue-700 border border-blue-100">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        System & Account Preferences
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight pt-1">
        Settings
      </h1>
      <p class="text-slate-500 text-sm font-medium">Manage your personal profile, role permissions, and tabulator configurations.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left Column (Settings Forms) -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Profile Settings Card -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-6">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900">User Profile Settings</h2>
            <p class="text-xs text-slate-500">Update your account display details</p>
          </div>
        </div>

        <form action="/settings/update" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Full Display Name</label>
            <input type="text" name="name" value="{{userName}}" required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm font-medium text-slate-800">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Email Address</label>
            <input type="email" value="{{userEmail}}" disabled
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm font-medium cursor-not-allowed">
            <p class="text-[11px] text-slate-400 mt-1">Email is managed by system authentication.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Assigned System Role</label>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold capitalize border
              {{#if isAdmin}}bg-blue-50 text-blue-700 border-blue-200{{else}}{{#if isJudge}}bg-purple-50 text-purple-700 border-purple-200{{else}}bg-emerald-50 text-emerald-700 border-emerald-200{{/if}}{{/if}}">
              <span class="w-2 h-2 rounded-full bg-current"></span>
              {{userRole}}
            </div>
          </div>

          <div class="pt-2 flex justify-end">
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-500/20 transition">
              Save Profile Changes
            </button>
          </div>
        </form>
      </div>

      <!-- Tabulation & Display Preferences Card -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-6">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900">Tabulation & Scoring Preferences</h2>
            <p class="text-xs text-slate-500">Configure score calculation and live leaderboards</p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-100">
            <div>
              <p class="text-xs font-bold text-slate-800">Decimal Precision for Final Tally</p>
              <p class="text-[11px] text-slate-500">Select floating-point rounding for weighted scores.</p>
            </div>
            <select class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="2" selected>2 Decimals (e.g. 98.75)</option>
              <option value="3">3 Decimals (e.g. 98.750)</option>
              <option value="1">1 Decimal (e.g. 98.8)</option>
            </select>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-100">
            <div>
              <p class="text-xs font-bold text-slate-800">AI Outlier Alert Threshold</p>
              <p class="text-[11px] text-slate-500">Trigger automatic audit warnings when judge variance exceeds threshold.</p>
            </div>
            <select class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="15" selected>&gt; 15% Deviation</option>
              <option value="10">&gt; 10% Strict Deviation</option>
              <option value="20">&gt; 20% Lenient Deviation</option>
            </select>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-100">
            <div>
              <p class="text-xs font-bold text-slate-800">Auto-Calculate Ranks in Realtime</p>
              <p class="text-[11px] text-slate-500">Instantly update contestant standing as judges submit scores.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer">
              <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-100">
            <div>
              <p class="text-xs font-bold text-slate-800">Drop Highest & Lowest Score (Olympic Rule)</p>
              <p class="text-[11px] text-slate-500">Discard extreme scores per contestant if 5+ judges are assigned.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer">
              <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- Submit Feature Suggestion Form -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-5">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900">Suggest a New Feature</h2>
            <p class="text-xs text-slate-500">Propose enhancements or new tabulator features directly to developers</p>
          </div>
        </div>

        <form action="/settings/suggest-feature" method="POST" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Feature Title</label>
              <input type="text" name="title" placeholder="e.g. Live Audio Announcement for Winners" required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm font-medium text-slate-800">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Category</label>
              <select name="category" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500">
                <option value="Scoring UX">Scoring UX</option>
                <option value="Printing">Printing & PDF</option>
                <option value="Connectivity">Connectivity & Sync</option>
                <option value="Security">Security & Audit</option>
                <option value="Display">Stage Display</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Detailed Description</label>
            <textarea name="description" rows="3" placeholder="Explain how this feature would benefit judges, encoders, or event administrators..." required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm font-medium text-slate-800"></textarea>
          </div>

          <div class="flex justify-end pt-1">
            <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow-md shadow-amber-500/20 transition">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Submit Feature Suggestion
            </button>
          </div>
        </form>
      </div>

      <!-- Suggested Community Features List -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Suggested Community Features</h2>
              <p class="text-xs text-slate-500">Popular requests submitted by judges and administrators</p>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          {{#each suggestions}}
          <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/60 hover:border-slate-200 transition">
            <div class="flex items-start justify-between gap-3 mb-1.5">
              <h3 class="text-xs font-bold text-slate-900">{{title}}</h3>
              <div class="flex items-center gap-1.5 flex-shrink-0">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-blue-100 text-blue-700 border border-blue-200/60">
                  {{category}}
                </span>
                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-slate-200/70 text-slate-700">
                  👍 {{votes}} votes
                </span>
              </div>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed mb-2">{{description}}</p>
            {{#if submittedBy}}
            <p class="text-[11px] text-slate-400 font-medium">Submitted by: <span class="text-slate-600 font-bold">{{submittedBy}}</span></p>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </div>

    </div>

    <!-- Right Column (System Info & Upcoming Features) -->
    <div class="space-y-6">

      <!-- System Info Card -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-5">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900">System Overview</h2>
            <p class="text-xs text-slate-500">ScoreSync Configuration</p>
          </div>
        </div>

        <div class="space-y-3.5 text-xs">
          <div class="flex items-center justify-between py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">Municipality / Unit</span>
            <span class="font-bold text-slate-800">{{municipality}}</span>
          </div>

          <div class="flex items-center justify-between py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">System Version</span>
            <span class="font-bold text-slate-800">{{systemVersion}}</span>
          </div>

          <div class="flex items-center justify-between py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">AI Audit Engine</span>
            <span class="font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded border border-purple-100">{{aiModel}}</span>
          </div>

          <div class="flex items-center justify-between py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">Database Connection</span>
            <span class="font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
            </span>
          </div>
        </div>

        <div class="pt-3">
          <a href="/logout" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs border border-rose-200/80 transition">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign Out of Account
          </a>
        </div>
      </div>

      <!-- Upcoming / Incoming Features Roadmap Card -->
      <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-2xl p-6 shadow-md border border-slate-800 space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center border border-indigo-500/30">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div>
              <h2 class="text-sm font-extrabold tracking-tight text-white">Upcoming Features</h2>
              <p class="text-[11px] text-slate-400">ScoreSync Product Roadmap</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 text-[10px] font-bold border border-indigo-500/30">
            Next Releases
          </span>
        </div>

        <div class="space-y-3.5">

          <!-- Feature 1 -->
          <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 hover:border-indigo-500/50 transition">
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-xs font-bold text-white flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                QR Code Judge Login Pass
              </h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">In Beta</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed">Encrypted single-use QR codes allowing judges to sign in instantly without typing passwords on event tablets.</p>
          </div>

          <!-- Feature 2 -->
          <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 hover:border-indigo-500/50 transition">
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-xs font-bold text-white flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                PDF Official Master Tally Export
              </h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Coming Q3 2026</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed">One-click PDF generation formatted per LGU ordinance with judge signature lines and official seal watermarks.</p>
          </div>

          <!-- Feature 3 -->
          <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 hover:border-indigo-500/50 transition">
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-xs font-bold text-white flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                Dual-Monitor Stage Popout Display
              </h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">Planned</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed">Dedicated full-screen stage presentation view with motion graphics for big-screen projectors at pageant venues.</p>
          </div>

          <!-- Feature 4 -->
          <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 hover:border-indigo-500/50 transition">
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-xs font-bold text-white flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                Live Biometric / SMS OTP Verification
              </h3>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">Planned</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed">2FA authorization required prior to final score submission to guarantee zero tampered entries.</p>
          </div>

        </div>
      </div>

    </div>

  </div>

</main>
</div>
{{> footer }}
</body>
</html>
