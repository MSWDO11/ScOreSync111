{{> head }}
<body class="bg-slate-50 min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <!-- Hero card -->
  <div class="card-flat overflow-hidden animate-fadeup">
    <div class="px-7 py-6 relative overflow-hidden" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
      <div class="absolute top-0 right-0 w-48 h-48 rounded-full translate-x-16 -translate-y-16" style="background:rgba(255,255,255,0.05)"></div>
      <div class="relative">
        <div class="breadcrumb mb-3" style="color:rgba(147,197,253,0.8)">
          <a href="/events" style="color:rgba(147,197,253,0.9)">Back to All Events</a>
        </div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-white text-2xl font-extrabold tracking-tight mb-2">{{event.name}}</h1>
            <div class="flex flex-wrap gap-4 text-blue-200 text-sm">
              {{#if event.venue}}<span class="flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{event.venue}}</span>{{/if}}
              {{#if event.date}}<span class="flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{{event.date}}{{#if event.time}} at {{event.time}}{{/if}}</span>{{/if}}
              <span class="capitalize flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>{{event.type}}</span>
              {{#if event.organizer}}<span class="flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>{{event.organizer}}</span>{{/if}}
            </div>
            {{#if event.description}}<p class="text-blue-100 text-sm mt-3 max-w-2xl leading-relaxed">{{event.description}}</p>{{/if}}
          </div>
          <span class="badge flex-shrink-0 mt-1 {{#if (eq event.status 'ongoing')}}badge-green{{else}}{{#if (eq event.status 'completed')}}badge-blue{{else}}{{#if (eq event.status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}}">{{event.status}}</span>
        </div>
      </div>
    </div>
    <!-- Action toolbar -->
    <div class="px-6 py-3 bg-white border-t border-slate-100 flex flex-wrap items-center gap-2">
      {{#if isAdmin}}
      {{#if (eq event.status 'upcoming')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline">
        <input type="hidden" name="status" value="ongoing">
        <button type="submit" class="btn-sm bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5 shadow-sm transition">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Start Event
        </button>
      </form>
      {{/if}}
      {{#if (eq event.status 'ongoing')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline" onsubmit="return confirm('Are you sure you want to manually end this event?')">
        <input type="hidden" name="status" value="completed">
        <button type="submit" class="btn-sm bg-blue-600 hover:bg-blue-700 text-white font-bold flex items-center gap-1.5 shadow-sm transition">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Manual End Event
        </button>
      </form>
      {{/if}}
      {{#if (eq event.status 'completed')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline">
        <input type="hidden" name="status" value="ongoing">
        <button type="submit" class="btn-sm btn-sm-gray flex items-center gap-1.5" title="Re-open event to active state">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg> Re-open Event
        </button>
      </form>
      {{/if}}
      <div class="h-4 w-px bg-slate-200 mx-1 hidden sm:block"></div>
      <a href="/events/{{event.id}}/edit" class="btn-sm btn-sm-gray"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</a>
      <a href="/events/{{event.id}}/contestants/add" class="btn-sm btn-sm-blue"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg> Add Contestant</a>
      <a href="/events/{{event.id}}/criteria" class="btn-sm btn-sm-purple"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Criteria</a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results</a>
      <a href="#scoresync-timer-component" onclick="document.getElementById('scoresync-timer-component')?.scrollIntoView({behavior:'smooth'})" class="btn-sm bg-indigo-600 hover:bg-indigo-700 text-white font-bold"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Stage Timer</a>
      <a href="/analytics?eventId={{event.id}}" class="btn-sm bg-purple-600 hover:bg-purple-700 text-white font-bold"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg> AI Score Audit</a>
      <form method="POST" action="/events/{{event.id}}/delete" class="inline" onsubmit="return confirm('Delete this event?')">
        <button type="submit" class="btn-sm btn-sm-red"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg> Delete</button>
      </form>
      {{/if}}
      {{#if isJudge}}
      <a href="#scoresync-timer-component" onclick="document.getElementById('scoresync-timer-component')?.scrollIntoView({behavior:'smooth'})" class="btn-sm btn-sm-blue"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Stage Timer</a>
      <a href="/events/{{event.id}}/scoring" class="btn-sm btn-sm-purple"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Score This Event</a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results</a>
      {{/if}}
      {{#if isEncoder}}
      <a href="#scoresync-timer-component" onclick="document.getElementById('scoresync-timer-component')?.scrollIntoView({behavior:'smooth'})" class="btn-sm btn-sm-blue"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Stage Timer</a>
      <a href="/events/{{event.id}}/contestants/add" class="btn-sm btn-sm-blue"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg> Add Contestant</a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results</a>
      {{/if}}
    </div>
  </div>

  <!-- Countdown Timer Component for Stage & Round Duration -->
  <div class="animate-fadeup-1">
    {{> countdown_timer }}
  </div>

  <div class="grid lg:grid-cols-2 gap-5 animate-fadeup-1">
    <!-- Contestants -->
    <div class="section-card">
      <div class="section-header">
        <h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Contestants <span class="ml-1.5 bg-blue-100 text-blue-600 text-xs font-bold px-2 py-0.5 rounded-full">{{contestants.length}}</span></h2>
        {{#if isAdmin}}<a href="/events/{{event.id}}/contestants/add" class="btn-primary btn-sm text-xs px-3 py-1.5"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add</a>{{/if}}
      </div>
      {{#if contestants.length}}
      <div class="p-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {{#each contestants}}
        <div class="group relative rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-lg transition-all duration-300 bg-white hover:-translate-y-1"
          style="aspect-ratio:3/4">
          <!-- Photo or gradient fallback -->
          {{#if photo}}
          <img src="{{photo}}" alt="{{name}}"
            class="absolute inset-0 w-full h-full object-cover"
            style="object-position:center top"/>
          {{else}}
          <div class="absolute inset-0 flex items-center justify-center" style="background:linear-gradient(160deg,#e0e7ff,#ede9fe)">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-xl font-black shadow-lg" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">{{number}}</div>
          </div>
          {{/if}}

          <!-- Gradient overlay always -->
          <div class="absolute inset-0" style="background:linear-gradient(0deg,rgba(10,20,60,0.75) 0%,rgba(10,20,60,0.15) 45%,transparent 70%)"></div>

          <!-- Number badge top-left -->
          <div class="absolute top-2 left-2">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-white text-xs font-extrabold shadow-md border border-white/30" style="background:rgba(37,99,235,0.85)">{{number}}</span>
          </div>

          <!-- Admin actions top-right -->
          {{#if ../isAdmin}}
          <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <a href="/events/{{../event.id}}/contestants/{{id}}/edit"
              class="w-7 h-7 rounded-full flex items-center justify-center bg-white/90 hover:bg-white text-slate-700 shadow transition">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </a>
            <form method="POST" action="/events/{{../event.id}}/contestants/{{id}}/delete" class="inline" onsubmit="return confirm('Remove contestant?')">
              <button class="w-7 h-7 rounded-full flex items-center justify-center bg-red-500/90 hover:bg-red-500 text-white shadow transition">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              </button>
            </form>
          </div>
          {{/if}}

          <!-- Name & details bottom -->
          <div class="absolute bottom-0 left-0 right-0 px-3 py-3">
            <div class="text-white font-extrabold text-sm leading-tight truncate">{{name}}</div>
            <div class="text-white/70 text-[11px] mt-0.5 truncate">
              {{#if barangay}}Brgy. {{barangay}}{{/if}}{{#if age}} &bull; {{age}} yrs{{/if}}
            </div>
            {{#if platform}}
            <div class="mt-1.5">
              <span class="inline-block bg-blue-500/80 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full truncate max-w-full">{{platform}}</span>
            </div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="py-10 text-center text-slate-400 text-sm">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-3"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        No contestants added yet.
      </div>
      {{/if}}
    </div>

    <!-- Criteria -->
    <div class="section-card">
      <div class="section-header">
        <h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>Scoring Criteria</h2>
        {{#if isAdmin}}<a href="/events/{{event.id}}/criteria" class="btn-sm btn-sm-purple text-xs px-3 py-1.5"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> Manage</a>{{/if}}
      </div>
      {{#if criteria.length}}
      <div class="divide-y divide-slate-50">
        {{#each criteria}}
        <div class="px-5 py-3.5 flex items-center justify-between hover:bg-slate-50 transition">
          <div>
            <div class="font-semibold text-slate-800 text-sm">{{name}}</div>
            {{#if description}}<div class="text-slate-400 text-xs mt-0.5">{{description}}</div>{{/if}}
          </div>
          <div class="text-right flex-shrink-0 ml-4">
            <div class="font-extrabold text-purple-600 text-sm">{{weight}}%</div>
            <div class="text-slate-400 text-xs">max {{maxScore}} pts</div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="py-10 text-center text-slate-400 text-sm">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-3"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        No criteria defined yet.
      </div>
      {{/if}}
    </div>
  </div>

  {{#if event.prizes}}
  <div class="grid lg:grid-cols-2 gap-5 animate-fadeup-2">
    <div class="section-card">
      <div class="section-header"><h2><svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>Prizes &amp; Awards</h2></div>
      <div class="px-5 py-4 text-sm text-slate-600 whitespace-pre-line leading-relaxed">{{event.prizes}}</div>
    </div>
    {{#if event.rules}}
    <div class="section-card">
      <div class="section-header"><h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>Rules &amp; Mechanics</h2></div>
      <div class="px-5 py-4 text-sm text-slate-600 whitespace-pre-line leading-relaxed">{{event.rules}}</div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if event.notes}}
  <div class="section-card animate-fadeup-2">
    <div class="section-header"><h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Additional Notes</h2></div>
    <div class="px-5 py-4 text-sm text-slate-600 whitespace-pre-line leading-relaxed">{{event.notes}}</div>
  </div>
  {{/if}}

  <!-- Payment QR Code Card (shown only if event has payment QR) -->
  {{#if event.paymentQR}}
  <div class="section-card animate-fadeup-2" style="border-color:#a7f3d0">
    <div class="section-header" style="background:#f0fdf4">
      <h2>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        Payment QR Code
        {{#if event.paymentMethod}}<span class="ml-2 badge badge-green text-[10px]">{{event.paymentMethod}}</span>{{/if}}
      </h2>
      <a href="/events/{{event.id}}/edit" class="btn-sm btn-sm-gray text-xs">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Edit
      </a>
    </div>
    <div class="px-6 py-6 flex flex-col sm:flex-row items-center gap-6">
      <!-- QR Image -->
      <div class="flex-shrink-0 p-3 bg-white rounded-2xl border border-emerald-100 shadow-sm">
        <img src="{{event.paymentQR}}" alt="Payment QR Code" class="rounded-xl" style="width:160px;height:160px;object-fit:contain"/>
      </div>
      <!-- Details -->
      <div class="flex-1 space-y-3 text-center sm:text-left">
        <div>
          <p class="text-xs text-slate-400 font-semibold uppercase tracking-wide">How to Pay</p>
          <p class="text-sm text-slate-600 mt-1 leading-relaxed">Scan the QR code using your <span class="font-bold text-emerald-700">{{#if event.paymentMethod}}{{event.paymentMethod}}{{else}}payment app{{/if}}</span> to send your payment directly.</p>
        </div>
        {{#if event.paymentAccountName}}
        <div class="flex items-center gap-2 text-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="text-slate-500">Account Name:</span>
          <span class="font-bold text-slate-800">{{event.paymentAccountName}}</span>
        </div>
        {{/if}}
        {{#if event.paymentAccountNumber}}
        <div class="flex items-center gap-2 text-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span class="text-slate-500">Account No.:</span>
          <span class="font-bold text-slate-800 font-mono tracking-wide">{{event.paymentAccountNumber}}</span>
        </div>
        {{/if}}
        <div class="flex gap-2 pt-1 justify-center sm:justify-start flex-wrap">
          <a href="{{event.paymentQR}}" download="payment-qr-{{event.id}}.png" class="btn-sm btn-sm-green text-xs">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download QR
          </a>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Event URL QR Code Card (event-dependent) -->
  <div class="section-card animate-fadeup-2">
    <div class="section-header">
      <h2>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="5" y="5" width="3" height="3" fill="#7c3aed"/><rect x="16" y="5" width="3" height="3" fill="#7c3aed"/><rect x="16" y="16" width="3" height="3" fill="#7c3aed"/><rect x="5" y="16" width="3" height="3" fill="#7c3aed"/></svg>
        Event QR Code
      </h2>
      <button onclick="downloadQR()" class="btn-sm btn-sm-purple text-xs px-3 py-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download
      </button>
    </div>
    <div class="px-6 py-6 flex flex-col sm:flex-row items-center gap-6">
      <div class="flex-shrink-0 p-3 bg-white rounded-2xl border border-slate-100 shadow-sm">
        <canvas id="event-qr-canvas" width="160" height="160"></canvas>
      </div>
      <div class="flex-1 space-y-2 text-center sm:text-left">
        <p class="font-bold text-slate-800 text-sm">{{event.name}}</p>
        <p class="text-xs text-slate-500 leading-relaxed">Scan this QR code to open the event page directly. Share it with judges, encoders, and participants for instant access.</p>
        <div class="mt-2 px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-500 font-mono break-all" id="qr-url-display"></div>
        <div class="flex gap-2 pt-1 justify-center sm:justify-start flex-wrap">
          <button onclick="copyEventUrl()" class="btn-sm btn-sm-gray text-xs">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy URL
          </button>
          <button onclick="downloadQR()" class="btn-sm btn-sm-purple text-xs">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download QR
          </button>
        </div>
      </div>
    </div>
  </div>

</main>
</div>

<!-- QR Code library (CDN, no install needed) -->
<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
<script>
  (function() {
    const eventId  = "{{event.id}}";
    const origin   = window.location.origin;
    const eventUrl = origin + "/events/" + eventId;

    document.getElementById("qr-url-display").textContent = eventUrl;

    QRCode.toCanvas(
      document.getElementById("event-qr-canvas"),
      eventUrl,
      {
        width:            160,
        margin:           2,
        color: { dark: "#1e1b4b", light: "#ffffff" },
        errorCorrectionLevel: "M",
      },
      function(err) {
        if (err) console.error("QR generation error:", err);
      }
    );

    window.downloadQR = function() {
      const canvas = document.getElementById("event-qr-canvas");
      const link   = document.createElement("a");
      link.download = "event-qr-{{event.id}}.png";
      link.href     = canvas.toDataURL("image/png");
      link.click();
    };

    window.copyEventUrl = function() {
      navigator.clipboard.writeText(eventUrl).then(function() {
        const btn = event.target.closest("button");
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
        setTimeout(function() { btn.innerHTML = orig; }, 1800);
      });
    };
  })();
</script>
{{> footer }}
</body>
</html>
