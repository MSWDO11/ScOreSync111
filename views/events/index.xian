{{> head }}
<body class="bg-slate-50 min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <div class="flex items-start justify-between animate-fadeup">
    <div class="page-header mb-0">
      <h1>Events</h1>
      <p>All competition events in ScoreSync.</p>
    </div>
    {{#if isAdmin}}
    <a href="/events/create" class="btn-primary text-sm flex-shrink-0">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Event
    </a>
    {{/if}}
  </div>

  {{#if events.length}}
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 animate-fadeup-1">
    {{#each events}}
    <div class="card overflow-hidden flex flex-col">
      <div class="px-5 py-4 relative overflow-hidden" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
        <div class="absolute top-0 right-0 w-24 h-24 rounded-full translate-x-8 -translate-y-8" style="background:rgba(255,255,255,0.06)"></div>
        <div class="relative">
          <div class="flex items-center justify-between mb-2">
            <span class="text-blue-200 text-[10px] font-bold uppercase tracking-widest capitalize">{{type}}</span>
            <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}}">{{status}}</span>
          </div>
          <h3 class="text-white font-extrabold text-base leading-tight">{{name}}</h3>
        </div>
      </div>
      <div class="px-5 py-4 flex-1 flex flex-col">
        <div class="space-y-1.5 text-sm text-slate-500 flex-1">
          {{#if venue}}<div class="flex items-center gap-2"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>{{venue}}</span></div>{{/if}}
          {{#if date}}<div class="flex items-center gap-2"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span>{{date}}</span></div>{{/if}}
        </div>
        <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-slate-100">
          <a href="/events/{{id}}" class="btn-primary btn-sm flex-1 justify-center py-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </a>
          {{#if ../isAdmin}}
            {{#if (eq status 'upcoming')}}
            <form method="POST" action="/events/{{id}}/status" class="inline flex-1">
              <input type="hidden" name="status" value="ongoing">
              <button type="submit" class="btn-sm bg-emerald-600 hover:bg-emerald-700 text-white font-semibold w-full justify-center py-2 text-xs">
                ▶ Start
              </button>
            </form>
            {{/if}}
            {{#if (eq status 'ongoing')}}
            <form method="POST" action="/events/{{id}}/status" class="inline flex-1" onsubmit="return confirm('Manually end event?')">
              <input type="hidden" name="status" value="completed">
              <button type="submit" class="btn-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold w-full justify-center py-2 text-xs">
                ✓ End
              </button>
            </form>
            {{/if}}
          <a href="/events/{{id}}/edit" class="btn-sm btn-sm-gray flex-1 justify-center py-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="card-flat py-20 text-center text-slate-400 animate-fadeup-1">
    <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-5">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <p class="font-semibold text-slate-600 text-base mb-1">No events yet</p>
    <p class="text-sm mb-5">Create your first competition event to get started.</p>
    {{#if isAdmin}}<a href="/events/create" class="btn-primary text-sm"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Create First Event</a>{{/if}}
  </div>
  {{/if}}

</main>
</div>
{{> footer }}
</body>
</html>
